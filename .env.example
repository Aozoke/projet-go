# Intervalle entre deux flush du buffer vers l'AOF OPFS, cote worker.
VITE_WASMREDIS_FLUSH_INTERVAL_MS=1000

# Intervalle entre deux snapshots complets du state, cote worker.
VITE_WASMREDIS_SNAPSHOT_INTERVAL_MS=120000

# Frequence du balayage des cles expirees.
VITE_WASMREDIS_EXPIRATION_SWEEP_INTERVAL_MS=1000

# Taille maximale du buffer AOF avant flush force.
VITE_WASMREDIS_MAX_BUFFER_SIZE=1000

# Hauteur fixe d'une ligne dans le virtual scroll React.
VITE_WASMREDIS_VIRTUAL_ROW_HEIGHT=42

# Nombre de lignes rendues en plus autour de la zone visible.
VITE_WASMREDIS_VIRTUAL_OVERSCAN=8

# Nombre d'entrees ajoutees par le bouton Seed.
VITE_WASMREDIS_DEMO_ENTRY_COUNT=100

# Taille d'un paquet pendant le seed.
VITE_WASMREDIS_DEMO_CHUNK_SIZE=25

# Duree de vie par defaut en secondes. 0 desactive le TTL par defaut.
VITE_WASMREDIS_DEFAULT_TTL_SECONDS=0

# Degre minimum du B-Tree. Une valeur de 8 suffit pour la demo.
VITE_WASMREDIS_BTREE_ORDER=8

# Nombre d'operations utilisees par le benchmark dans l'interface.
VITE_WASMREDIS_BENCHMARK_ITERATIONS=30
